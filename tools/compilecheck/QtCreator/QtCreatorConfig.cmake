# Compile-check stand-in for Qt Creator's development package.
#
# Lets the plugin be compiled against Qt Creator's *source* headers when the
# official qtcreator_dev archive is unavailable (offline CI, blocked
# download.qt.io, a not yet released version, ...). It provides the pieces of
# the real package qnvim uses: the IDE_* version variables, add_qtc_plugin()
# and INTERFACE targets QtCreator::<Lib> carrying include paths and the
# import-side defines.
#
# The plugin is linked as a shared library with Qt Creator's symbols left
# unresolved, so this proves that the code compiles against the API of that
# Qt Creator version; it does not produce a binary that is guaranteed to load.
# Release builds must use the real development package.
#
# Usage:
#   cmake -S . -B build-check -G Ninja -DFETCH_QTC=OFF \
#         -DQTC_SOURCE_DIR=/path/to/qt-creator-sources \
#         -DCMAKE_PREFIX_PATH="$PWD/tools/compilecheck;/path/to/Qt6"

cmake_minimum_required(VERSION 3.22)

if (NOT QTC_SOURCE_DIR)
  if (DEFINED ENV{QTC_SOURCE_DIR})
    set(QTC_SOURCE_DIR "$ENV{QTC_SOURCE_DIR}")
  else()
    message(FATAL_ERROR "compilecheck: set QTC_SOURCE_DIR to a Qt Creator source checkout")
  endif()
endif()

set(QtCreator_FOUND TRUE)
set(QTC_COMPILECHECK TRUE)

# Version variables, read from the sources' branding file.
include("${QTC_SOURCE_DIR}/cmake/QtCreatorIDEBranding.cmake")
message(STATUS "compilecheck: Qt Creator ${IDE_VERSION} (compat ${IDE_VERSION_COMPAT}) sources in ${QTC_SOURCE_DIR}")

find_package(Qt6 REQUIRED COMPONENTS Core Gui Widgets Network Concurrent PrintSupport Xml Qml)
find_package(Qt6 QUIET COMPONENTS TaskTree)

# KSyntaxHighlighting's CamelCase forwarding headers are generated by ECM at
# build time; generate equivalent ones for the public headers.
set(_ksh_src "${QTC_SOURCE_DIR}/src/libs/3rdparty/syntax-highlighting/src/lib")
set(_ksh_gen "${CMAKE_BINARY_DIR}/compilecheck-generated")
file(GLOB _ksh_headers RELATIVE "${_ksh_src}" "${_ksh_src}/*.h")
foreach(_h IN LISTS _ksh_headers)
  if (_h MATCHES "_p\\.h$")
    continue()
  endif()
  file(STRINGS "${_ksh_src}/${_h}" _cls REGEX "^class KSYNTAXHIGHLIGHTING_EXPORT [A-Za-z]+")
  foreach(_line IN LISTS _cls)
    string(REGEX REPLACE "^class KSYNTAXHIGHLIGHTING_EXPORT ([A-Za-z]+).*" "\\1" _name "${_line}")
    file(WRITE "${_ksh_gen}/KSyntaxHighlighting/${_name}" "#include \"${_ksh_src}/${_h}\"\n")
  endforeach()
endforeach()
# Headers without an exported class (enums, namespaces).
file(WRITE "${_ksh_gen}/KSyntaxHighlighting/FoldingRegion" "#include \"${_ksh_src}/foldingregion.h\"\n")

set(_qtc_includes
  "${QTC_SOURCE_DIR}/src/libs"
  "${QTC_SOURCE_DIR}/src/plugins"
  "${QTC_SOURCE_DIR}/src/libs/3rdparty"
  "${QTC_SOURCE_DIR}/src/libs/utils/mimetypes2"
  "${QTC_SOURCE_DIR}/src/libs/utils/plaintextedit"
  "${_ksh_src}"
  "${QTC_SOURCE_DIR}/src/libs/3rdparty/syntax-highlighting/autogenerated/src/lib"
  "${_ksh_gen}"
)

function(_qtc_interface name)
  if (TARGET QtCreator::${name})
    return()
  endif()
  add_library(QtCreator::${name} INTERFACE IMPORTED GLOBAL)
  set_target_properties(QtCreator::${name} PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${_qtc_includes}"
    INTERFACE_LINK_LIBRARIES "Qt6::Core;Qt6::Gui;Qt6::Widgets;Qt6::Network;Qt6::Concurrent;Qt6::Xml;Qt6::Qml")
  if (TARGET Qt6::TaskTree)
    set_property(TARGET QtCreator::${name} APPEND PROPERTY INTERFACE_LINK_LIBRARIES Qt6::TaskTree)
  endif()
endfunction()

foreach(_lib Utils ExtensionSystem Aggregation Core TextEditor ProjectExplorer CppEditor)
  _qtc_interface(${_lib})
endforeach()

# Minimal add_qtc_plugin(): keyword set compatible with the real one for the
# arguments qnvim passes.
function(add_qtc_plugin target_name)
  cmake_parse_arguments(_arg "" "" "PLUGIN_DEPENDS;DEPENDS;PUBLIC_DEPENDS;SOURCES;DEFINES" ${ARGN})

  # Plugin dependencies → JSON, as the real macro does.
  set(_deps "")
  foreach(_d IN LISTS _arg_PLUGIN_DEPENDS)
    string(REGEX REPLACE "^QtCreator::" "" _d "${_d}")
    string(TOLOWER "${_d}" _id)
    list(APPEND _deps "        { \"Id\" : \"${_id}\", \"Version\" : \"${IDE_VERSION}\" }")
  endforeach()
  list(JOIN _deps ",\n" _deps_joined)
  set(IDE_PLUGIN_DEPENDENCIES "\"Dependencies\" : [\n${_deps_joined}\n    ]")
  if (EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/${target_name}.json.in")
    configure_file("${target_name}.json.in" "${CMAKE_CURRENT_BINARY_DIR}/${target_name}.json")
  endif()

  add_library(${target_name} SHARED ${_arg_SOURCES})
  target_include_directories(${target_name} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
  string(TOUPPER "${target_name}_LIBRARY" _export)
  target_compile_definitions(${target_name} PRIVATE ${_export} ${_arg_DEFINES}
    QT_NO_FOREACH QT_USE_QSTRINGBUILDER)
  target_link_libraries(${target_name} PRIVATE ${_arg_DEPENDS} ${_arg_PUBLIC_DEPENDS} ${_arg_PLUGIN_DEPENDS})
  set_target_properties(${target_name} PROPERTIES
    LIBRARY_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/lib/qtcreator/plugins")
endfunction()
